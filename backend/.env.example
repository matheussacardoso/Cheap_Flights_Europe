# Copy to .env and adjust as needed. Never commit the real .env.

# "production" hides /docs, /redoc and /openapi.json
ENVIRONMENT=development
APP_NAME="Ryanair Flight Search API"
DEBUG=false
LOG_LEVEL=INFO
# false = human-readable logs for local development
LOG_JSON=true
CORS_ORIGINS=["http://localhost:4200","http://127.0.0.1:4200"]

# Ryanair public website API (unofficial) for the airport/route network
RYANAIR_WEB_API_URL=https://www.ryanair.com
NETWORK_CACHE_TTL_SECONDS=86400
UPSTREAM_TIMEOUT_SECONDS=10
